---
import { text } from '../../data/approved-copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCatalog from '../../components/TourCatalog.astro';
import { copy } from '../../data/site';
import { tours } from '../../data/tours';

const lang = 'en';
const c = copy[lang];
---

<BaseLayout title="Cabo Diving Tours | Hammerhead Divers" description="Compare scuba diving, wildlife and PADI course experiences from Hammerhead Divers. Book through WeTravel or ask on WhatsApp." lang={lang}>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">{text(lang,19,'Eyebrow',c.sections.toursEyebrow)}</div>
        <h1>{text(lang, 19, "Título", "Ocean tours")}</h1>
        <p>{text(lang, 19, "Descripción", "Structured for fast buying decisions: price, duration, level, inclusions, season and direct WeTravel booking links.")}</p>
      </div>
    </section>
    <TourCatalog lang={lang} />
  </main>
</BaseLayout>
