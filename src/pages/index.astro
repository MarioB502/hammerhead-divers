---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { contact } from '../data/site';

const lang = 'en';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Hammerhead Divers',
  url: 'https://hammerheaddivers.com/',
  telephone: contact.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cabo San Lucas',
    addressRegion: 'Baja California Sur',
    addressCountry: 'MX'
  },
  description: 'Premium boutique scuba diving and ocean adventures in Cabo San Lucas, Baja California Sur.'
};
---

<BaseLayout title="Hammerhead Divers | Premium Scuba Diving in Cabo San Lucas" description="Premium boutique scuba diving and ocean adventures in Cabo San Lucas. Small groups, certified guides, WeTravel booking and WhatsApp support." lang={lang} schema={schema}>
  <HomeContent lang={lang} />
</BaseLayout>
