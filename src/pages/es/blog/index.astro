---
import { text } from '../../../data/approved-copy';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'es';
const posts = (await getCollection('blog')).filter((post) => post.data.lang === 'en').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postImages: Record<string, string> = {
  'best-time-to-dive-in-cabo': '/assets/scuba-group.jpg',
  'gordo-banks-hammerhead-diving': '/assets/hammerhead-shark.jpg',
  'whale-shark-tour-la-paz-guide': '/assets/whale-shark-hero.jpg',
};
const articleNumber = (slug: string) => ({'best-time-to-dive-in-cabo': 1, 'gordo-banks-hammerhead-diving': 2, 'whale-shark-tour-la-paz-guide': 3}[slug]);
const [featuredPost, ...morePosts] = posts;
---

<BaseLayout title="Blog de buceo | Hammerhead Divers" description="Guias de buceo, vida marina y viajes en Baja California Sur." lang={lang}>
  <main>
    <section class="page-hero blog-hero">
      <div class="container">
        <div class="eyebrow">{text(lang, 23, "Eyebrow", "Diario de buceo")}</div>
        <h1>{text(lang, 23, "Título", "Blog de buceo")}</h1>
        <p>{text(lang, 23, "Descripción", "Guias practicas de Cabo y Baja para viajeros que comparan temporadas, vida marina, seguridad y la experiencia ideal antes de reservar.")}</p>
      </div>
    </section>
    <section class="section blog-section">
      <div class="container">
        {featuredPost && (
          <article class="featured-post">
            <a class="featured-post-image" href={`/blog/${featuredPost.slug}/`} aria-label={text(lang,23,`Artículo ${articleNumber(featuredPost.slug)} – título`,featuredPost.data.title) }>
              <img src={postImages[featuredPost.slug] ?? '/assets/arch-cabo.jpg'} alt="" loading="eager" />
            </a>
            <div class="featured-post-body">
              <span class="pill">{text(lang,23,`Artículo ${articleNumber(featuredPost.slug)} – categoría`,featuredPost.data.category) }</span>
              <h2>{text(lang,23,`Artículo ${articleNumber(featuredPost.slug)} – título`,featuredPost.data.title) }</h2>
              <p>{text(lang,23,`Artículo ${articleNumber(featuredPost.slug)} – descripción`,featuredPost.data.description) }</p>
              <a class="btn btn-primary" href={`/blog/${featuredPost.slug}/`}>Leer artículo</a>
            </div>
          </article>
        )}

        <div class="blog-grid">
          {morePosts.map((post) => (
            <article class="card post-card">
              <a class="post-card-image" href={`/blog/${post.slug}/`} aria-label={text(lang,23,`Artículo ${articleNumber(post.slug)} – título`,post.data.title) }>
                <img src={postImages[post.slug] ?? '/assets/arch-cabo.jpg'} alt="" loading="lazy" />
              </a>
              <div class="post-card-body">
                <span class="pill">{text(lang,23,`Artículo ${articleNumber(post.slug)} – categoría`,post.data.category) }</span>
                <h3>{text(lang,23,`Artículo ${articleNumber(post.slug)} – título`,post.data.title) }</h3>
                <p>{text(lang,23,`Artículo ${articleNumber(post.slug)} – descripción`,post.data.description) }</p>
                <a class="btn btn-secondary" href={`/blog/${post.slug}/`}>Leer artículo</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
