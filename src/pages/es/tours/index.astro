---
import { text } from '../../../data/approved-copy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourCatalog from '../../../components/TourCatalog.astro';
import { copy } from '../../../data/site';
import { tours } from '../../../data/tours';

const lang = 'es';
const c = copy[lang];
---

<BaseLayout title="Tours de buceo en Cabo | Hammerhead Divers" description="Compara experiencias de buceo, vida marina y cursos PADI. Reserva por WeTravel o pregunta por WhatsApp." lang={lang}>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">{text(lang,19,'Eyebrow',c.sections.toursEyebrow)}</div>
        <h1>{text(lang, 19, "Título", "Tours oceánicos")}</h1>
        <p>{text(lang, 19, "Descripción", "Precio, duración, nivel, inclusiones, temporada y reserva directa por WeTravel.")}</p>
      </div>
    </section>
    <TourCatalog lang={lang} />
  </main>
</BaseLayout>
