---
import { getCollection } from 'astro:content';
import JournalArticle from '../../../components/JournalArticle.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => post.data.lang === 'fr');
  return posts.map((post) => ({ params: { slug: post.slug.split('/').pop()! }, props: { post } }));
}
const { post } = Astro.props;
---
<JournalArticle post={post} lang="fr" />
