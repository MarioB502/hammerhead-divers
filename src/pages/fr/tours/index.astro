---
import { text } from '../../../data/approved-copy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TourCard from '../../../components/TourCard.astro';
import { copy } from '../../../data/site';
import { tours } from '../../../data/tours';

const lang = 'fr';
const c = copy[lang];
---

<BaseLayout title="Tours de plongée à Cabo | Hammerhead Divers" description="Comparez les expériences de plongée, faune marine et cours PADI. Réservez via WeTravel ou demandez sur WhatsApp." lang={lang}>
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="eyebrow">{text(lang,19,'Eyebrow',c.sections.toursEyebrow)}</div>
        <h1>{text(lang, 19, "Título", "Tours océaniques")}</h1>
        <p>{text(lang, 19, "Descripción", "Prix, durée, niveau, inclusions, saison et réservation directe via WeTravel.")}</p>
      </div>
    </section>
    <section class="section tour-catalog"><div class="container grid grid-3 tour-card-grid">{tours.map((tour) => <TourCard tour={tour} lang={lang} />)}</div></section>
  </main>
</BaseLayout>
