---
import '../styles/global.css';
import { contact, copy, languages, type Lang } from '../data/site';

type Props = {
  title: string;
  description: string;
  lang?: Lang;
  canonical?: string;
  schema?: Record<string, unknown>;
};

const { title, description, lang = 'en', canonical, schema } = Astro.props;
const c = copy[lang];
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const whatsMessage = encodeURIComponent(
  lang === 'es'
    ? 'Hola, quiero más información sobre los tours de Hammerhead Divers.'
    : lang === 'fr'
      ? 'Bonjour, je souhaite plus d’informations sur les tours de Hammerhead Divers.'
      : 'Hi, I would like more information about Hammerhead Divers tours.'
);
const whatsUrl = `https://wa.me/${contact.phoneRaw}?text=${whatsMessage}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ?? Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical ?? Astro.url.href} />
    <meta name="theme-color" content="#03111f" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={langPrefix || '/'}>
          <img class="brand-logo" src="/assets/logo-icon.png" alt="Hammerhead Divers logo" width="42" height="42" />
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={`${langPrefix}/tours/`}>{c.nav.tours}</a>
          <a href={`${langPrefix}/#wildlife`}>{c.nav.wildlife}</a>
          <a href={`${langPrefix}/#about`}>{c.nav.about}</a>
          <a href={`${langPrefix}/blog/`}>{c.nav.blog}</a>
        </nav>
        <div class="nav-actions">
          <div class="lang-switch" aria-label="Language selector">
            {Object.entries(languages).map(([code, item]) => (
              <a class={code === lang ? 'active' : ''} href={item.path}>{item.label}</a>
            ))}
          </div>
          <a class="btn btn-primary" href={contact.wetravel} target="_blank" rel="noopener">{c.nav.book}</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href={langPrefix || '/'}>
              <img class="brand-logo footer-brand-logo" src="/assets/logo-icon.png" alt="Hammerhead Divers logo" width="56" height="56" />
            </a>
            <p>Premium boutique diving and ocean adventures in Cabo San Lucas, Baja California Sur. Women-owned, small-group, conservation-driven.</p>
          </div>
          <div>
            <h3>{c.nav.tours}</h3>
            <p><a href={`${langPrefix}/tours/`}>Scuba diving</a><br /><a href={`${langPrefix}/tours/`}>Wildlife tours</a><br /><a href={`${langPrefix}/tours/`}>PADI courses</a></p>
          </div>
          <div>
            <h3>Contact</h3>
            <p><a href={whatsUrl}>WhatsApp</a><br /><a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.phone}</p>
          </div>
          <div>
            <h3>Social</h3>
            <p><a href={contact.instagram}>Instagram</a><br /><a href={contact.facebook}>Facebook</a><br /><a href={contact.tripadvisor}>TripAdvisor</a></p>
          </div>
        </div>
        <div class="footer-bottom">© 2026 Hammerhead Divers · Site by B502 · Static build ready for HostGator</div>
      </div>
    </footer>
    <div class="mobile-sticky">
      <a class="btn btn-primary" href={contact.wetravel} target="_blank" rel="noopener">{c.nav.book}</a>
      <a class="btn btn-whatsapp" href={whatsUrl}>{c.cta.whats}</a>
    </div>
  </body>
</html>
