---
import { text } from '../data/approved-copy';
import '../styles/global.css';
import { contactUI } from '../data/contact-page';
import { contact, copy, languages, type Lang } from '../data/site';

type Props = {
  title: string;
  description: string;
  lang?: Lang;
  canonical?: string;
  languagePaths?: Partial<Record<Lang, string>>;
  schema?: Record<string, unknown>;
};

const { title, description, lang = 'en', canonical, schema, languagePaths } = Astro.props;
const c = copy[lang];
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const whatsMessage = encodeURIComponent(
  lang === 'es'
    ? 'Hola, quiero más información sobre los tours de Hammerhead Divers.'
    : lang === 'fr'
      ? 'Bonjour, je souhaite plus d’informations sur les tours de Hammerhead Divers.'
      : 'Hi, I would like more information about Hammerhead Divers tours.'
);
const whatsUrl = `https://wa.me/${contact.phoneRaw}?text=${whatsMessage}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ?? Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical ?? Astro.url.href} />
    <meta name="theme-color" content="#03111f" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href={langPrefix || '/'}>
          <img class="brand-logo" src="/assets/logo-icon.png" alt="Hammerhead Divers logo" width="42" height="42" />
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={`${langPrefix}/tours/`}>{c.nav.tours}</a>
          <a href={`${langPrefix}/#wildlife`}>{c.nav.wildlife}</a>
          <a href={`${langPrefix}/#about`}>{c.nav.about}</a>
          <a href={`${langPrefix}/blog/`}>{c.nav.blog}</a>
          <a href={`${langPrefix}/contact/`}>{contactUI[lang].nav}</a>
        </nav>
        <details class="mobile-menu">
          <summary aria-label={ {en:'Open navigation menu',es:'Abrir menú de navegación',fr:'Ouvrir le menu de navigation'}[lang] }><span aria-hidden="true">☰</span> <span>{ {en:'Menu',es:'Menú',fr:'Menu'}[lang] }</span></summary>
          <nav aria-label={ {en:'Mobile navigation',es:'Navegación móvil',fr:'Navigation mobile'}[lang] }>
            <a href={`${langPrefix}/tours/`}>{c.nav.tours}</a>
            <a href={`${langPrefix}/tours/#local-diving`}>{ {en:'Local diving',es:'Buceo local',fr:'Plongée locale'}[lang] }</a>
            <a href={`${langPrefix}/tours/#full-day-diving`}>{ {en:'Full-day diving',es:'Buceo de día completo',fr:'Plongée à la journée'}[lang] }</a>
            <a href={`${langPrefix}/tours/#snorkeling`}>Snorkeling</a>
            <a href={`${langPrefix}/tours/#courses`}>{ {en:'Courses',es:'Cursos',fr:'Cours'}[lang] }</a>
            <a href={`${langPrefix}/#wildlife`}>{c.nav.wildlife}</a>
            <a href={`${langPrefix}/#about`}>{c.nav.about}</a>
            <a href={`${langPrefix}/blog/`}>{c.nav.blog}</a>
            <a href={`${langPrefix}/contact/`}>{contactUI[lang].nav}</a>
          </nav>
        </details>
        <div class="nav-actions">
          <div class="lang-switch" aria-label="Language selector">
            {Object.entries(languages).map(([code, item]) => (
              <a class={code === lang ? 'active' : ''} href={languagePaths?.[code as Lang] ?? item.path}>{item.label}</a>
            ))}
          </div>
          <a class="btn btn-primary" href={contact.wetravel} target="_blank" rel="noopener">{c.nav.book}</a>
        </div>
      </div>
    </header>

    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      menu?.addEventListener('keydown', event => {
        if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
    </script>
    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href={langPrefix || '/'}>
              <img class="brand-logo footer-brand-logo" src="/assets/logo-icon.png" alt="Hammerhead Divers logo" width="56" height="56" />
            </a>
            <p>{text(lang, 3, "Footer – posicionamiento", "Premium boutique diving and ocean adventures in Cabo San Lucas, Baja California Sur. Women-owned, small-group, conservation-driven.")}</p>
          </div>
          <div>
            <h3>{text(lang,3,'Footer – categoría',c.nav.tours)}</h3>
            <p><a href={`${langPrefix}/tours/`}>{text(lang,3,'Footer – links','Scuba diving · Wildlife tours · PADI courses').split(' · ')[0]}</a><br /><a href={`${langPrefix}/tours/`}>{text(lang,3,'Footer – links','Scuba diving · Wildlife tours · PADI courses').split(' · ')[1]}</a><br /><a href={`${langPrefix}/tours/`}>{text(lang,3,'Footer – links','Scuba diving · Wildlife tours · PADI courses').split(' · ')[2]}</a></p>
          </div>
          <div>
            <h3><a href={`${langPrefix}/contact/`}>{contactUI[lang].nav}</a></h3>
            <p><a href={whatsUrl}>WhatsApp</a><br /><a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.phone}</p>
          </div>
          <div>
            <h3>Social</h3>
            <p><a href={contact.instagram}>Instagram</a><br /><a href={contact.facebook}>Facebook</a><br /><a href={contact.tripadvisor}>TripAdvisor</a><br /><a href={contact.tiktok}>TikTok</a></p>
          </div>
        </div>
        <div class="footer-bottom">© 2026 Hammerhead Divers · Site by B502 · Static build ready for HostGator</div>
      </div>
    </footer>
    <div class="mobile-sticky">
      <a class="btn btn-primary" href={contact.wetravel} target="_blank" rel="noopener">{c.nav.book}</a>
      <a class="btn btn-whatsapp" href={whatsUrl}>{c.cta.whats}</a>
    </div>
  </body>
</html>
