---
import data from '../data/reviews.json';
import { reviewsUI } from '../data/contact-page';
import type { Lang } from '../data/site';
import '../styles/contact.css';
type Props = { lang: Lang; provider: 'tripadvisor' | 'google' };
const { lang, provider } = Astro.props;
const ui = reviewsUI[lang];
const group = data[provider];
const platform = provider === 'google' ? 'Google' : 'Tripadvisor';
const locale = {en:'en-US',es:'es-MX',fr:'fr-FR'}[lang];
const date = (value: string) => new Intl.DateTimeFormat(locale,{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(value+'T12:00:00Z'));
const reviews = group.reviews as Array<{ author: string; date: string; rating?: number; title?: string; text?: string; summary?: Record<Lang,string>; url?: string }>;
---
<section class="section reviews-section" aria-label={`${ui.eyebrow} · ${platform}`}>
 <div class="container">
  <div class="reviews-heading"><div><div class="eyebrow">{ui.eyebrow} · {platform}</div><h2>{provider === 'google' ? ui.googleTitle : ui.tripTitle}</h2><p>{provider === 'google' ? ui.googleIntro : ui.tripIntro}</p></div><a class="btn btn-secondary" href={group.url} target="_blank" rel="noopener noreferrer">{ui.all} ↗</a></div>
  {provider === 'tripadvisor' && <p class="reviews-instruction">{ui.scroll} · {ui.originalLanguage}</p>}
  <div class:list={['reviews-track',{'reviews-three':provider==='google'}]} tabindex="0" role="region" aria-label={`${platform} · ${ui.eyebrow}`}>
   {reviews.map((review) => <article class="review-card">
    <div class="review-author"><span class="review-avatar" aria-hidden="true">{review.author.slice(0,1)}</span><div><h3>{review.author}</h3><time datetime={review.date}>{date(review.date)}</time></div><span class="review-platform">{platform}</span></div>
    {review.rating != null && <div class="review-rating" aria-label={`${ui.rating}: ${review.rating}/5`}><span aria-hidden="true">{'★'.repeat(review.rating)}{'☆'.repeat(5-review.rating)}</span><span>{review.rating}/5</span></div>}
    {review.summary ? <><span class="review-summary-label">{ui.summary}</span><p>{review.summary[lang]}</p></> : <><h4>{review.title}</h4><p>{(review.text ?? '').slice(0,180)}{(review.text?.length ?? 0)>180 ? '…' : ''}</p>{(review.text?.length ?? 0)>180 && <details><summary>{ui.expand}</summary><p>{review.text}</p></details>}</>}
    <a class="review-source" href={review.url ?? group.url} target="_blank" rel="noopener noreferrer">{review.url ? ui.original : ({en:'View on Tripadvisor',es:'Ver en Tripadvisor',fr:'Voir sur Tripadvisor'}[lang])} ↗</a>
   </article>)}
  </div>
  <p class="reviews-snapshot">{ui.snapshot} {date(group.retrievedOn)}. {ui.snapshotNote}</p>
 </div>
</section>
