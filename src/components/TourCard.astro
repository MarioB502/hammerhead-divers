---
import { text, cardCopy } from '../data/approved-copy';
import type { Tour } from '../data/tours';
import { contact, copy, type Lang } from '../data/site';

type Props = { tour: Tour; featured?: boolean; lang?: Lang };
const { tour, lang = 'en', featured = false } = Astro.props;
const c = copy[lang];
const card = cardCopy(tour, lang, featured);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const whatsText = encodeURIComponent(`Hi, I would like information about ${tour.title.en}.`);
const whatsUrl = `https://wa.me/${contact.phoneRaw}?text=${whatsText}`;
---

<article class="card tour-card">
  <a class="tour-image" href={`${langPrefix}/tours/${tour.slug}/`} aria-label={card.title}>
    <img src={tour.image} alt={card.title} loading="lazy" />
    <span>{card.badge}</span>
  </a>
  <div class="tour-card-copy">
    <span class="pill tour-category">{card.category}</span>
    <h3>{card.title}</h3>
    <p>{card.summary}</p>
  </div>
  <div class="meta">
    {card.meta.map((value) => <span>{value}</span>)}
  </div>
  <div class="card-actions">
    <a class="btn btn-primary" href={`${langPrefix}/tours/${tour.slug}/`}>{card.actions[0]}</a>
    <a class="btn btn-whatsapp" href={whatsUrl} aria-label={`${c.cta.whats}: ${card.title}`}>{c.cta.whats}</a>
  </div>
</article>
